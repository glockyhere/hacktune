# Production settings — the ONE file you fill in.
#
#   cp deploy/production.env.example deploy/production.env
#   nano deploy/production.env          # fill everything below
#   python deploy/configure.py          # stamps every config from these values
#
# This file contains your card numbers, so it is gitignored. Never commit it.

# --- domain ----------------------------------------------------------------
# Your Cloudflare domain, bare (no https://, no trailing slash).
# Layout (chosen): web app at the root, API on the api. subdomain.
DOMAIN=example.com

# Optional overrides. Leave blank to derive them from DOMAIN:
#   APP_HOST      -> ${DOMAIN}            the web client buyers open
#   API_HOST      -> api.${DOMAIN}        the activation backend on your VPS
#   PAYLOAD_HOST  -> payload.${DOMAIN}    R2 custom domain holding the APKs
APP_HOST=
API_HOST=
PAYLOAD_HOST=

# --- what buyers see -------------------------------------------------------
# Two cards, rendered in the wallets on the payment step. Numbers may contain
# spaces; they are shown as typed and copied without them.
CARD_1_BRAND=UZCARD
CARD_1_NUMBER=
CARD_1_HOLDER=

CARD_2_BRAND=HUMO
CARD_2_NUMBER=
CARD_2_HOLDER=

TELEGRAM=@your_telegram
PRICE_TEXT=200 000 so'm

# --- VPS ------------------------------------------------------------------
# Used only to print the exact commands in the deploy summary.
VPS_IP=

# Port the activation service listens on, and that Caddy proxies to. Must match
# --port in carapk-activation.service. 8080 is already taken on this VPS by an
# unrelated process, so the default is 8081. Change both together or not at all.
API_PORT=8081

# Secrets below are GENERATED if left blank (configure.py writes them into
# deploy/vps-env.generated for you to merge into /etc/carapk/activation.env).
# Your existing SIGNING_KEY_PKCS8 / TG_BOT_TOKEN / TG_CHAT_ID are never touched.
DOWNLOAD_HMAC_KEY=
PAYLOAD_AUTH_VALUE=
