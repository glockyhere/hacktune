# Copy to /etc/carapk/activation.env  (chmod 600, owned by the carapk user).
# These are SECRETS — never commit this filled-in.

# base64 PKCS8 Ed25519 private key from: python keygen/generate_activation_keys.py
SIGNING_KEY_PKCS8=

# long random password for the admin HTTP endpoints (Telegram is the main path)
ADMIN_TOKEN=

# Telegram bot token from @BotFather
TG_BOT_TOKEN=

# your numeric Telegram id (from @userinfobot) — the ONLY account allowed to approve
TG_CHAT_ID=

# sqlite location (the service user must be able to write here)
DB_PATH=/var/lib/carapk/activations.db

# --- Web client (browser) --------------------------------------------------
# Origins allowed to call this API from a browser. The web app is a static
# page on a different origin, so without this every call fails the CORS
# preflight ("Load failed"). No cookies are used (auth is the one-time token in
# the body), so "*" is safe; pin it to your own site(s) if you prefer.
#   WEB_ORIGINS=*                       (any origin)
#   WEB_ORIGINS=https://install.example.com,https://www.example.com
WEB_ORIGINS=*

# Web provisioning (only needed if buyers install from the browser). The recipe
# and payload never ship in the page; the server signs short-lived /dl URLs.
#   DOWNLOAD_HMAC_KEY  any long random string (signs /dl links)
#   PAYLOAD_ORIGIN     PRIVATE base URL the APKs live behind (NOT the public bucket)
#   DOWNLOAD_TTL       seconds a signed /dl URL stays valid (default 900)
DOWNLOAD_HMAC_KEY=
PAYLOAD_ORIGIN=
DOWNLOAD_TTL=900
