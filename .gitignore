# --- payload binaries: hosted in the cloud, never committed -------------------
payload/*.apk

# --- secrets: signing keys / filled env files must NEVER be committed ---------
keygen/license_private.key
server_vps/*.env
!server_vps/*.env.example
*.db

# --- python / build artifacts -------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/CarApkInstaller/
*.egg-info/

# --- external tools (fetched per machine) -------------------------------------
tools/platform-tools/
tools/build-tools/
tools/jre/

# --- web client build artifacts -----------------------------------------------
webapp/node_modules/
webapp/dist/

# --- production deployment: real domain, cards and generated secrets ----------
deploy/production.env
deploy/vps-env.generated

# --- os junk ------------------------------------------------------------------
.DS_Store
Thumbs.db
